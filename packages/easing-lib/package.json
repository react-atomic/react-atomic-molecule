{
  "version": "0.3.1",
  "name": "easing-lib",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-atomic/react-atomic-molecule",
    "directory": "packages/easing-lib"
  },
  "homepage": "https://github.com/react-atomic/react-atomic-molecule/tree/main/packages/easing-lib",
  "description": "Easings Js Library",
  "keywords": [
    "easing",
    "animation"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "MIT",
  "dependencies": {
    "call-func": "^0.3.12",
    "win-doc": "^0.3.4"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "typescript": "^5.9.3"
  },
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./build/cjs/src/index.js",
    "import": "./build/es/src/index.mjs"
  },
  "types": "./types/index.d.ts",
  "main": "./build/cjs/src/index.js",
  "module": "./build/es/src/index.mjs",
  "scripts": {
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs/src --ignore /**/__tests__ --root-mode upward",
    "build:es": "BABEL_ENV=es babel src -d build/es/src --out-file-extension .mjs --root-mode upward",
    "build:types": "tsc src/*.js --declaration --allowJs --emitDeclarationOnly --skipLibCheck --declarationDir types",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:types",
    "test": "npm run build && bun test",
    "prepublishOnly": "npm t"
  },
  "files": [
    "types",
    "build",
    "package.json",
    "README.md"
  ]
}
