{
  "version": "19.0.0",
  "name": "react-atomic-molecule",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-atomic/react-atomic-molecule"
  },
  "description": "Atomic design in React (molecules)",
  "keywords": [
    "react-atomic",
    "react-atomic-ui"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "MIT",
  "dependencies": {
    "array.merge": "^0.2.2",
    "call-func": "^0.5.3",
    "class-lib": "^0.2.1",
    "create-el": "^0.2.7",
    "css-query-selector": "^0.5.2",
    "get-object-value": "^0.8.1",
    "hyphenate-style-name": "1.1.0",
    "need-css": "^0.3.0",
    "react-atomic-atom": "^19.0.0",
    "reshow-build": "^1.19.2",
    "reshow-constant": "^0.18.0",
    "reshow-runtime": "^0.17.15",
    "ucfirst-js": "^0.2.0",
    "win-doc": "^0.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@types/react": "^19.3.0",
    "lerna": "^10.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reshow-unit": "^0.19.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./build/cjs/src/index.js",
    "import": "./build/es/src/index.mjs"
  },
  "main": "./build/cjs/src/index.js",
  "module": "./build/es/src/index.mjs",
  "scripts": {
    "up-all": "lerna exec 'yarn upgrade'",
    "format": "prettier-eslint --write 'src/**/*.js' 'ui/**/*.js*'",
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs/src --ignore /**/__tests__",
    "build:es": "BABEL_ENV=es babel src -d build/es/src --out-file-extension .mjs",
    "build:type": "tsc src/*.js src/ui/**/*.jsx --jsx react-jsx --lib esnext,dom --declaration --allowJs --emitDeclarationOnly --skipLibCheck --allowSyntheticDefaultImports --noCheck --declarationDir types",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:type",
    "mochaFor": "mocha -r global-jsdom/register",
    "mocha": "npm run mochaFor -- 'build/es/**/__tests__/*.mjs'",
    "test:report": "npm run build && npm run mochaFor -- --reporter mocha-junit-reporter --reporter-options mochaFile=./test_output/mocha.xml 'build/es/**/__tests__/*.mjs'",
    "test": "npm run build && npm run mocha",
    "prepublishOnly": "npm run format && npm run test"
  },
  "types": "./types/index.d.ts",
  "files": [
    "types",
    "build",
    "package.json",
    "README.md"
  ]
}
